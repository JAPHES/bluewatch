DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
BLUEWATCH_DEMO_PASSWORD=
MAP_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
MAP_TILE_ATTRIBUTION=Tiles &copy; Esri and contributing data providers
MAP_VECTOR_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
SATELLITE_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
SATELLITE_TILE_ATTRIBUTION=Imagery: Esri, Maxar, Earthstar Geographics, and the GIS User Community
SATELLITE_LABEL_URL=https://who.maptiles.arcgis.com/arcgis/rest/services/World_Hybrid_Overlay/MapServer/tile/{z}/{y}/{x}
SATELLITE_LABEL_ATTRIBUTION=Labels &copy; Esri and contributing data providers
SATELLITE_MAX_NATIVE_ZOOM=18
# Optional staff-only Google hybrid map preview; leave blank to use free maps only.
GOOGLE_MAPS_DEMO_KEY=
REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODER_CONTACT=your-public-support-email@example.org
