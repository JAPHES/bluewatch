{
  "version": 8,
  "name": "BlueWatch OSM hybrid overlay",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet/latest"
    }
  },
  "layers": [
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 10,
      "paint": {
        "line-color": "#68d7ec",
        "line-opacity": 0.65,
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 17, 2]
      }
    },
    {
      "id": "road-halo",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["!", ["in", ["get", "class"], ["literal", ["rail", "transit"]]]],
      "paint": {
        "line-color": "#1a3440",
        "line-opacity": 0.65,
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1.5, 17, 4]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["!", ["in", ["get", "class"], ["literal", ["rail", "transit"]]]],
      "paint": {
        "line-color": "#e8f7fa",
        "line-opacity": 0.85,
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.6, 17, 1.8]
      }
    },
    {
      "id": "named-places",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 15, 15],
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#16323f",
        "text-halo-width": 2
      }
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-max-angle": 30,
        "symbol-spacing": 300
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#16323f",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "named-local-places",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-max-width": 10,
        "text-padding": 4,
        "text-optional": false
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#16323f",
        "text-halo-width": 2
      }
    }
  ]
}
